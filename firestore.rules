rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Unmatched Paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check endpoint
    match /system_test/{testId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 1. ADMINS COLLECTION
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 2. TEACHERS COLLECTION
    // -------------------------------------------------------------
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 3. STUDENTS COLLECTION
    // -------------------------------------------------------------
    match /students/{studentId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 4. CLASSES COLLECTION
    // -------------------------------------------------------------
    match /classes/{classId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 5. HOMEWORKS COLLECTION
    // -------------------------------------------------------------
    match /homeworks/{homeworkId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 6. HOMEWORK SUBMISSIONS COLLECTION
    // -------------------------------------------------------------
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 7. ETUTS (ETÜT VE BİREBİR TAKİP)
    // -------------------------------------------------------------
    match /etuts/{etutId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 8. QUESTION LOGS (SORU SAYISI TAKİP)
    // -------------------------------------------------------------
    match /question_logs/{logId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 9. WEEKLY QUESTION TARGETS (SORU HEDEFLERİ)
    // -------------------------------------------------------------
    match /weekly_question_targets/{targetId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 10. MESSAGES (ÖĞRENCİ - ÖĞRETMEN İLETİŞİMİ)
    // -------------------------------------------------------------
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 11. TEACHER DOCUMENTS (DÖKÜMAN & ZÜMRE ARŞİVİ)
    // -------------------------------------------------------------
    match /teacher_documents/{docId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 12. ATTENDANCE (YOKLAMA KAYITLARI)
    // -------------------------------------------------------------
    match /attendance/{attId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 13. GRADES (SINAV VE NOT KAYITLARI)
    // -------------------------------------------------------------
    match /grades/{gradeId} {
      allow read, write: if true;
    }
  }
}


